    {
      "name": "0ce81f65",
      "displayName": "gold_tweet_aggregations",
      "config": {
        "version": "1.1",
        "source": "workspace.default.gold_tweet_aggregations",
        "dimensions": [
          {
            "name": "mention",
            "expr": "source.mention",
            "displayName": "Mention"
          },
          {
            "name": "positive",
            "expr": "source.positive",
            "displayName": "Positive"
          },
          {
            "name": "negative",
            "expr": "source.negative",
            "displayName": "Negative"
          },
          {
            "name": "total",
            "expr": "source.total",
            "displayName": "Total"
          },
          {
            "name": "min_timestamp",
            "expr": "source.min_timestamp",
            "displayName": "Min Timestamp"
          },
          {
            "name": "max_timestamp",
            "expr": "source.max_timestamp",
            "displayName": "Max Timestamp"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "79b18a8b",
      "displayName": "Tweet Mention Counts Summary Dataset",
      "queryLines": [
        "WITH bronze_total AS (\n",
        "  SELECT COUNT(*) AS total_tweets\n",
        "  FROM tweets_bronze\n",
        "),\n",
        "\n",
        "silver_no_mentions AS (\n",
        "  SELECT COUNT(*) AS tweets_without_mentions\n",
        "  FROM tweets_silver\n",
        "  WHERE mention IS NULL\n",
        ")\n",
        "\n",
        "SELECT\n",
        "  b.total_tweets,\n",
        "  s.tweets_without_mentions,\n",
        "  m.tweets_with_mentions\n",
        "FROM bronze_total b\n",
        "CROSS JOIN silver_no_mentions s\n",
        "CROSS JOIN (\n",
        "    SELECT COUNT(*) AS tweets_with_mentions\n",
        "    FROM tweets_silver\n",
        "    WHERE mention IS NOT NULL\n",
        ") m;"
      ]
    },
    {
      "name": "a675a2e7",
      "displayName": "Top Ten Mentions Ranked by Tweet Volume",
      "queryLines": [
        "SELECT\n",
        "  user,\n",
        "  COUNT(*) AS tweet_count\n",
        "FROM tweets_bronze\n",
        "GROUP BY user\n",
        "ORDER BY tweet_count DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "5afb228d",
      "displayName": "Top Mentions Ranked by Positive Sentiment Score",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  (positive - negative) AS `Sentiment Power (pos-neg)`\n",
        "FROM gold_tweet_aggregations\n",
        "WHERE mention IS NOT NULL\n",
        "ORDER BY (positive - negative) DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "df6530c5",
      "displayName": "Top Negative Mentions from Gold Tweet Aggregations",
      "queryLines": [
        "SELECT\n",
        "  mention,\n",
        "  (negative - positive) AS `Sentiment Power (neg-pos)`\n",
        "FROM gold_tweet_aggregations\n",
        "WHERE mention IS NOT NULL\n",
        "ORDER BY (negative - positive) DESC\n",
        "LIMIT 10;"
      ]
    }
  ],
